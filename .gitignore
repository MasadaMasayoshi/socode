# 秘密情報（MongoDB Atlasの接続文字列等）を含む実際の設定ファイル。
# 見本は.env.exampleを参照（そちらはGitに含めて構わない）。
.env

# ローカル実行時のフォールバック保存先（MONGODB_URI未設定時にここへJSONで保存される）。
# 患者の記録を含みうるため、誤って公開しないようGitには含めない。
data/

node_modules/

# 作業用の控え（古い写し・画面の画像・印刷見本など）。公開には不要。
Claude outputs/
_to_delete/

# 以前の本体（js/01〜10に分けたため使われていない）
app-1.js
app-2.js

# 分類結果の比較テストに使う事例の文章と、その分類結果（実習の事例演習の文章）。
# 教材の文章なので公開しない（手元のテストでは使える）。
tests/golden/cases/
tests/golden/expected/

# 架空データのみを使うブラウザ検証の出力
browser-artifacts/

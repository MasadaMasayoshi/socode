{
  "name": "nursing-assessment-support",
  "version": "1.0.0",
  "description": "Nursing assessment support with a shared learning backend",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node scripts/run-tests.js",
    "golden": "node scripts/golden.js",
    "golden:update": "node scripts/golden.js --update",
    "build:css": "npx tailwindcss@3.4.17 -c tailwind.config.js -i tailwind.input.css -o vendor/tailwind.css --minify",
    "stamp": "node scripts/stamp-version.js",
    "test:quiet": "node scripts/test-quiet.js",
    "map": "node scripts/file-map.js",
    "ship": "node scripts/ship.js",
    "test:legacy": "node --test tests/golden/legacy-classification.test.js tests/golden/legacy-real-record.test.js",
    "test:public": "node scripts/run-tests.js"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongodb": "^6.9.0"
  }
}
